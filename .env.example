# 高德开放平台 https://console.amap.com/dev/key/app
# 勿把真实 Key 提交进仓库；Pages 用 Actions Secrets 注入

# Web服务 Key —— 输入提示 / POI / 地理编码 / 驾车 / 公交 / 步行（必填以启用真实能力）
VITE_AMAP_KEY=

# Web端(JS API) Key —— 可选；填写后使用官方 AMap 矢量底图（否则用高德栅格瓦片 + Leaflet）
VITE_AMAP_JS_KEY=

# JS API 安全密钥（控制台「安全密钥」）；官方矢量底图时常需要
VITE_AMAP_SECURITY_CODE=
